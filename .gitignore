# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# fvm — .fvmrc at the repo root is the committed source of truth for the
# pinned SDK version; everything under .fvm/ is a machine-local symlink/cache
# (fvm use --force also creates .fvm/versions/<ver>, not just .fvm/flutter_sdk)
.fvm/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store

# Secrets — the Unsplash key is passed via --dart-define, never committed
*.env
.env.*

# SDD scratch
.superpowers/
